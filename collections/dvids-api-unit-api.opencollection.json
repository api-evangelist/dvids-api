{
  "opencollection": "1.0.0",
  "info": {
    "name": "DVIDS Asset Unit API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Unit",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search units",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dvidshub.net/unit/search",
            "params": [
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              },
              {
                "name": "unit_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "branch",
                "value": "",
                "type": "query"
              },
              {
                "name": "unit_abbrev",
                "value": "",
                "type": "query"
              },
              {
                "name": "unit_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "max_results",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortdir",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search the DVIDS unit directory by name, abbreviation, branch, or ID."
        }
      ]
    }
  ],
  "bundled": true
}